# GEMINI_API_KEY: Required for Gemini AI API calls (handout generator, exam study assistant, quiz questions).
# On AI Studio: Automatically injected from Settings > Secrets.
# On Vercel: Set this in Vercel Dashboard > Project > Settings > Environment Variables.
# Obtain a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="https://api.paystack.co"

# PAIRGATE_API_KEY: VTU Provider API Key (server-side only, never exposed to client)
PAIRGATE_API_KEY=""

# PAIRGATE_BASE_URL: Base API URL for VTU telecom provider
PAIRGATE_BASE_URL="https://pairgate.com/api/v1"

# PAIRGATE_ENVIRONMENT: "sandbox" for development/testing or "live" for production
PAIRGATE_ENVIRONMENT="live"

# PAYSTACK_BASE_URL: Base URL for Paystack API
PAYSTACK_BASE_URL="https://api.paystack.co"

# PAYSTACK_SECRET_KEY: Paystack Secret Key (server-side only, set in Vercel / environment secrets)
PAYSTACK_SECRET_KEY=""

# PAYSTACK_PUBLIC_KEY: Paystack Public Key (for frontend popup initialization)
PAYSTACK_PUBLIC_KEY="pk_live_70e9ddbaca92590a8bfbd673b80abb40f083ac96"
VITE_PAYSTACK_PUBLIC_KEY="pk_live_70e9ddbaca92590a8bfbd673b80abb40f083ac96"

# BREVO_API_KEY: Brevo (Sendinblue) Transactional Email API Key for verification emails
BREVO_API_KEY=""

# BREVO_SENDER_EMAIL: Sender email address configured in Brevo domain settings
BREVO_SENDER_EMAIL="auth@grobaax.app"

# BREVO_SENDER_NAME: Display name for system verification emails
BREVO_SENDER_NAME="Grobaax Arena Security"

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""

